{
  "name": "petalpace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "start:api": "node --env-file-if-exists=.env.local server/index.mjs",
    "test:feedback": "node --test server/feedback.test.mjs",
    "test:auth": "node --test server/auth.test.mjs",
    "test:profile": "node --test server/profile-photo.test.mjs",
    "test:planner": "node --test server/planner.test.mjs",
    "test:calendar": "node --test server/calendar.test.mjs",
    "test": "node --test --test-timeout=120000 server/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:backup": "node scripts/database-copy.mjs",
    "db:restore": "node scripts/database-copy.mjs",
    "deploy:check": "node scripts/deploy-smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
